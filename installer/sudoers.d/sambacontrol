# /etc/sudoers.d/sambacontrol
# Restricted sudo allowlist for the SambaControl service user.
# Edit only with:  sudo visudo -f /etc/sudoers.d/sambacontrol

Defaults:sambacontrol !requiretty
Defaults:sambacontrol env_reset
Defaults:sambacontrol secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# --- Samba user management ---
sambacontrol ALL=(root) NOPASSWD: /usr/bin/smbpasswd
sambacontrol ALL=(root) NOPASSWD: /usr/sbin/smbpasswd

# --- Linux user management (no-shell accounts only) ---
sambacontrol ALL=(root) NOPASSWD: /usr/sbin/useradd
sambacontrol ALL=(root) NOPASSWD: /usr/sbin/userdel
sambacontrol ALL=(root) NOPASSWD: /usr/bin/passwd

# --- POSIX ACLs + share directory management ---
sambacontrol ALL=(root) NOPASSWD: /usr/bin/setfacl
sambacontrol ALL=(root) NOPASSWD: /usr/bin/getfacl
sambacontrol ALL=(root) NOPASSWD: /usr/bin/mkdir
sambacontrol ALL=(root) NOPASSWD: /bin/mkdir
sambacontrol ALL=(root) NOPASSWD: /usr/bin/chown
sambacontrol ALL=(root) NOPASSWD: /bin/chown
sambacontrol ALL=(root) NOPASSWD: /usr/bin/chmod
sambacontrol ALL=(root) NOPASSWD: /bin/chmod

# --- Legacy config discovery (read-only) ---
# testparm reads smb.conf, pdbedit reads the passdb backend
# (/var/lib/samba/private/passdb.tdb) — both root-owned on a hardened box.
sambacontrol ALL=(root) NOPASSWD: /usr/bin/testparm
sambacontrol ALL=(root) NOPASSWD: /usr/sbin/testparm
sambacontrol ALL=(root) NOPASSWD: /usr/bin/pdbedit
sambacontrol ALL=(root) NOPASSWD: /usr/sbin/pdbedit

# --- Config file writes (atomic install via temp file) ---
sambacontrol ALL=(root) NOPASSWD: /usr/bin/install

# --- Samba service control ---
sambacontrol ALL=(root) NOPASSWD: /usr/bin/systemctl reload smbd
sambacontrol ALL=(root) NOPASSWD: /usr/bin/systemctl restart smbd
sambacontrol ALL=(root) NOPASSWD: /usr/bin/systemctl reload nmbd
sambacontrol ALL=(root) NOPASSWD: /usr/bin/systemctl restart nmbd
sambacontrol ALL=(root) NOPASSWD: /bin/systemctl reload smbd
sambacontrol ALL=(root) NOPASSWD: /bin/systemctl restart smbd

# --- Self-restart (deferred via systemd-run from fix.sh) ---
sambacontrol ALL=(root) NOPASSWD: /usr/bin/systemd-run --quiet --on-active=5s --unit=sambacontrol-restart-once /bin/systemctl restart sambacontrol-backend
sambacontrol ALL=(root) NOPASSWD: /usr/bin/systemctl daemon-reload
sambacontrol ALL=(root) NOPASSWD: /bin/systemctl daemon-reload

# --- nginx (refresh during fix.sh) ---
sambacontrol ALL=(root) NOPASSWD: /usr/sbin/nginx -t
sambacontrol ALL=(root) NOPASSWD: /usr/bin/systemctl reload nginx
sambacontrol ALL=(root) NOPASSWD: /bin/systemctl reload nginx

# --- sudoers refresh validation ---
sambacontrol ALL=(root) NOPASSWD: /usr/sbin/visudo -c -f /etc/sudoers.d/sambacontrol

# --- The GUI update button triggers fix.sh ---
sambacontrol ALL=(root) NOPASSWD: /opt/sambacontrol/scripts/fix.sh
sambacontrol ALL=(root) NOPASSWD: /opt/sambacontrol/update.sh
sambacontrol ALL=(root) NOPASSWD: /opt/sambacontrol/scripts/rollback.sh
sambacontrol ALL=(root) NOPASSWD: /opt/sambacontrol/scripts/backup.sh
